{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "apiRoute": {
        "ClusterId": "apiCluster",
        "Match": {
          "Path": "/api/{**catchAll}"
        }
      },
      "uploadsRoute": {
        "ClusterId": "apiCluster",
        "Match": {
          "Path": "/uploads/{**catchAll}"
        }
      }
    },
    "Clusters": {
      "apiCluster": {
        "Destinations": {
          "apiDestination": {
            "Address": "http://localhost:5081/"
          }
        }
      }
    }
  }
}